{
  "name": "@anvia/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "eval": "pnpm eval:hukum && pnpm eval:faq && pnpm eval:perilaku",
    "eval:hukum": "tsx --env-file-if-exists=../../.env src/evals/eval-hukum.ts",
    "eval:faq": "tsx --env-file-if-exists=../../.env src/evals/eval-faq.ts",
    "eval:perilaku": "tsx --env-file-if-exists=../../.env src/evals/eval-perilaku.ts"
  },
  "dependencies": {
    "@anvia/core": "^1.14.1",
    "@anvia/openai": "^1.3.0",
    "@tavily/core": "^0.7.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
